{
  "id": "hmgapi-tile-manager",
  "name": "Home Screen Tile Manager",
  "version": "1.0.7",
  "hmgapi": ">=1.0.0",
  "authors": ["lemoyneiv"],
  "license": "AGPL-3.0",
  "repo": "https://github.com/lemoyneiv/hmgapi-tile-manager",
  "description": "Show or hide stock system apps and mod packages on the Gen5W home screen and menu editor while leaving blank spaces intact, collapse empty spaces on demand, launch stock Edit Home Icons, and automatically back up and restore hidden tiles.",
  "live": true,
  "apps": [
    {
      "apk": "app/TileManager.apk",
      "package": "dev.lemoyne.tiles"
    }
  ],
  "hooks": {
    "jar": "hooks.jar",
    "entry": "dev.lemoyne.tiles.hook.TileModEntry",
    "points": {
      "launcher.menu_entry.new": "observe",
      "launcher.menu_list.load": "observe",
      "homesetting.edit_entry.new": "observe",
      "homesetting.edit_list.load": "observe"
    }
  },
  "provides": {
    "launcher": [
      {
        "title": "Tile Manager",
        "package": "dev.lemoyne.tiles",
        "class": ".MainActivity",
        "icon": "icons/icon.png",
        "icon_night": "icons/icon_night.png",
        "icon_disabled": "icons/icon_disabled.png",
        "icon_disabled_night": "icons/icon_disabled_night.png"
      }
    ],
    "star_key": [
      {
        "id": "open",
        "title": "Home Screen Tile Manager",
        "activity": {
          "package": "dev.lemoyne.tiles",
          "class": ".MainActivity"
        }
      }
    ]
  },
  "logs": {
    "tags": ["HmgTiles"],
    "match": ["[hmgapi-tile-manager]"]
  }
}
